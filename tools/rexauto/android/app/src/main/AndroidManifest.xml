<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Allow access to Bluetooth devices (Hunt v1.4.6 ronda 20,
         A4-R20-01): the SDL HIDAPI driver for Bluetooth Steam Controllers
         (HIDDeviceBLESteamController) needs BLUETOOTH_CONNECT on API 31+
         — a runtime permission, which SDL requests at joystick init and
         initializeBluetooth() re-checks — and BLUETOOTH on API <=30.
         Without these declarations the merged release manifest carried
         only VIBRATE, so the whole BLE stack was dead code. No scanning
         is done (bonded devices + GATT only), so BLUETOOTH_SCAN is not
         needed. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <!-- The Xenos GPU backend needs a full Vulkan 1.1 implementation. -->
    <uses-feature
        android:name="android.hardware.vulkan.version"
        android:version="0x00401000"
        android:required="true" />

    <!-- Android 12+: declare game mode support so performance mode is offered. -->
    <application
        android:allowBackup="false"
        android:name=".PortApp"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:appCategory="game"
        android:isGame="true"
        android:requestLegacyExternalStorage="false"
        android:theme="@style/AppTheme">

        <!-- (Ronda 6, auditor F — R6-F8.) La lista era mas corta que la de
             MainActivity: un cambio de densidad (escala de fuente), de
             smallestScreenSize (pantalla dividida) o de uiMode (modo oscuro)
             recreaba SetupActivity a mitad de un import y el hilo de import
             se quedaba con la actividad destruida. Misma lista que
             MainActivity, que ya la lleva completa.
             (Caza ronda 6, A4-R6-04.) Faltaban locale|fontScale|
             layoutDirection en AMBAS activities: un cambio de idioma o de
             tamano de fuente del sistema a mitad de partida recreaba la
             activity y SDLActivity.onDestroy mataba el juego (progreso no
             guardado perdido). CAMBIO DE COMPORTAMIENTO VISIBLE: la
             activity ya no se recrea en esos cambios; el onConfiguration-
             Changed de SDLActivity (onNativeLocaleChanged) por fin corre. -->
        <activity
            android:name=".SetupActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|density|locale|fontScale|layoutDirection"
            android:exported="false"
            android:screenOrientation="sensorLandscape" />

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|uiMode|screenSize|smallestScreenSize|density|locale|fontScale|layoutDirection"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
